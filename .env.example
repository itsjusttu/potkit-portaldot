# Vite bakes these into the bundle at BUILD time. On Vercel: set them under
# Project → Settings → Environment Variables, then REDEPLOY after every change.
# PotKit is ONE contract (receipts + vault + settlement + market): put its address here.
VITE_KIT=
# Optional legacy names — may all hold the same PotKit address (VITE_KIT wins if set):
# VITE_RECEIPT=
# VITE_VAULT=
# VITE_MARKET=
# VITE_USD is no longer used: settlement and market payments are native tPOT.
# Primary RPC (default: https://test-evm-rpc-v3.portaldot.dev)
VITE_RPC_URL=
# Optional backup RPC(s), comma-separated; used through viem fallback()
VITE_RPC_URL2=
# Block number of the PotKit deploy tx — event/history scan starts here
VITE_FROM_BLOCK=
# Public site URL (e.g. https://potkit.vercel.app), used for share links
VITE_SITE_URL=
# Optional dedicated dApp origin; Launch App and judge links go here (e.g. https://app.potkit.pro)
VITE_APP_URL=
# (api/r.ts, the tokenURI metadata endpoint, reads VITE_KIT and VITE_RPC_URL on the server too.)

# ---- Gas faucet (SERVER-ONLY — used by api/faucet.ts, never exposed to the browser) ----
# Never prefix these with VITE_. Use a dedicated throwaway wallet with a small balance.
# FAUCET_PRIVATE_KEY=0x…            # faucet wallet key (fund its mapped 5… account)
# FAUCET_AMOUNT=0.5                 # tPOTv3 per request (18-decimal EVM view)
# FAUCET_THRESHOLD=0.5              # skip if recipient already has >= this (default = FAUCET_AMOUNT)
# FAUCET_MAX_PER_HOUR=30            # global cap on sends per hour
# FAUCET_RPC_URL=                   # defaults to VITE_RPC_URL, then the public V3 RPC
# Optional shared rate limiting (otherwise best-effort in-memory per instance):
# KV_REST_API_URL= / KV_REST_API_TOKEN=            (Vercel KV / Upstash via Vercel Marketplace)
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
