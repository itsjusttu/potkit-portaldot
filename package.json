{
  "name": "potkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PotKit — tokenise real-world receipts on Portaldot V3: ERC-721 receipt, vault-locked ERC-20 shares, public on-chain board.",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node scripts/compile.mjs && node --test test/*.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "lenis": "^1.3.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ganache": "^7.9.2",
    "solc": "0.8.28",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
